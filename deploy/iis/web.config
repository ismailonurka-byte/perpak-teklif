<?xml version="1.0" encoding="UTF-8"?>
<!--
  ============================================================
  PERPAK / Vanto - IIS Reverse Proxy
  Adres : http://perpakambalaj.com.tr/   (SSL eklenince https'e geçer)
  Hedef : http://localhost:8000          (uvicorn / FastAPI)

  KURULUM SIRASI (kisaca):
    1) IIS + URL Rewrite 2.1 + ARR 3.0 kurulu olmali
    2) ARR > Server Proxy Settings > "Enable proxy" isaretli olmali
    3) IIS > sunucu dugumu > URL Rewrite > View Server Variables ile
       HTTP_X_FORWARDED_PROTO ve HTTP_X_FORWARDED_HOST eklenmis olmali
    4) Bu dosya: C:\inetpub\vanto\web.config olarak kaydedilir
    5) IIS'te site binding'inde Host name = perpakambalaj.com.tr yazilir

  NOT: Alan adi BURADA yazmaz; IIS site binding'inde belirlenir.
       {HTTP_HOST} sayesinde bu dosya her alan adiyla calisir.
  ============================================================
-->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>

        <!--
          ====== SSL EKLEYINCE ACIN ======
          Asagidaki blogun basindaki  "<!- -"  ve sonundaki  "- ->"  isaretlerini
          kaldirin. HTTP ile gelen herkesi otomatik HTTPS'e yonlendirir.
          (win-acme ile sertifika alip 443 binding'i eklendikten SONRA acin.)
        -->
        <!--
        <rule name="HTTP-to-HTTPS" stopProcessing="true">
          <match url="(.*)" />
          <conditions>
            <add input="{HTTPS}" pattern="off" />
          </conditions>
          <action type="Redirect" url="https://{HTTP_HOST}/{R:1}" redirectType="Permanent" />
        </rule>
        -->

        <!-- ====== Asil reverse proxy: her istegi uvicorn'a ilet ====== -->
        <rule name="ReverseProxyToUvicorn" stopProcessing="true">
          <match url="(.*)" />
          <action type="Rewrite" url="http://localhost:8000/{R:1}" />
          <serverVariables>
            <!-- Uygulamaya "istek http mu https mi geldi" bilgisini dogru aktarir -->
            <set name="HTTP_X_FORWARDED_PROTO" value="{MapProto:{HTTPS}}" />
            <set name="HTTP_X_FORWARDED_HOST"  value="{HTTP_HOST}" />
          </serverVariables>
        </rule>

      </rules>

      <!-- HTTPS=on ise "https", off ise "http" uretir -->
      <rewriteMaps>
        <rewriteMap name="MapProto">
          <add key="on"  value="https" />
          <add key="off" value="http" />
        </rewriteMap>
      </rewriteMaps>
    </rewrite>

    <!-- Buyuk teklif/PDF istekleri icin makul ust sinir (50 MB) -->
    <security>
      <requestFiltering>
        <requestLimits maxAllowedContentLength="52428800" />
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
