# Database — varsayılan SQLite (tek dosya, kurulum gerektirmez)
DATABASE_URL=sqlite:///./perpak.db
# Postgres kullanmak istersen:
# DATABASE_URL=postgresql+psycopg://perpak:perpak@db:5432/perpak_teklif

# Security
SECRET_KEY=change-this-to-a-secure-random-string-min-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# SMTP (e-mail otomasyonu — şimdilik OFF)
SMTP_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Perpak Teklif <teklif@perpak.com.tr>

# App
APP_NAME=Perpak Teklif
APP_ENV=development
LOG_LEVEL=INFO
